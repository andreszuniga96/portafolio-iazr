# ═══════════════════════════════════════════════════════════════════════════════
#  .env.example — Plantilla de variables de entorno para IAZR Portfolio
#  ──────────────────────────────────────────────────────────────────────────────
#  1. Copia este archivo y renómbralo a `.env.local`
#  2. Rellena los valores con tus claves reales
#  3. ¡NUNCA subas `.env.local` a Git! (ya está en .gitignore)
#  
#  Para Vercel: agrega cada variable en:
#     Dashboard → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# ── Motor conversacional (Vercel AI SDK + Groq) ─────────────────────────────
# OBLIGATORIA para respuestas reales del asistente. Sin ella, el chat responde
# en "modo demo" con una respuesta predefinida.
# Consíguela en https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modelo opcional (por defecto: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Entrega del formulario de contacto (Resend) ──────────────────────────────
# OPCIONAL. Sin ella el formulario opera en "modo demo" (exito sin envio).
# Consiguela en https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Remitente del correo verificado en Resend
# RESEND_FROM=IAZR <no-reply@tudominio.com>

# ── URL de produccion (SEO: metadataBase, Open Graph, JSON-LD) ───────────────
# Cambia al dominio real cuando lo compres (ej: https://iazr.dev)
NEXT_PUBLIC_SITE_URL=https://portafolio-iazr.vercel.app

# ── Telemetria (PostHog) ─────────────────────────────────────────────────────
# OPCIONAL. Sin ella el formulario funciona pero sin analytics.
# Consiguela en PostHog -> Project Settings -> API Keys (empieza por phc_...)
POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Host de ingesta (US por defecto, cambiar a https://eu.i.posthog.com si EU)
# POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
