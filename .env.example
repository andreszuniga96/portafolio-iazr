# ═════════════════════════════════════════════════════════════════════════════
#  VARIABLES DE ENTORNO — IAZR Portfolio
#  Copia este archivo a `.env.local` y rellena los valores.
#  ⚠️ `.env.local` NO debe versionarse (está en .gitignore).
# ═════════════════════════════════════════════════════════════════════════════

# ── Motor conversacional (Vercel AI SDK + Groq) ─────────────────────────────
# OBLIGATORIA para respuestas reales del asistente. Sin ella, el chat responde
# en "modo demo" con una respuesta predefinida (MockLanguageModelV4 de ai/test).
# Consíguela en https://console.groq.com/keys
GROQ_API_KEY=

# Modelo opcional (por defecto: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Entrega del formulario de contacto (Server Action) ───────────────────────
# OPCIONAL. Sin ella el formulario opera en "modo demo" (éxito sin envío).
# Consíguela en https://resend.com/api-keys
RESEND_API_KEY=

# Remitente del correo. Default: IAZR Portfolio <onboarding@resend.dev>
# (solo envía a la dirección con la que registraste la cuenta en Resend).
# Al verificar un dominio propio, usa algo como: IAZR <no-reply@iazr.dev>
# RESEND_FROM=IAZR <no-reply@iazr.dev>

# ── URL de producción (SEO: metadataBase, Open Graph, JSON-LD) ───────────────
# Opcional: por defecto se usa https://portafolio-iazr.vercel.app
NEXT_PUBLIC_SITE_URL=https://portafolio-iazr.vercel.app

# ── Telemetría de conversión del formulario (PostHog) ────────────────────────
# OPCIONAL. Sin ella el formulario sigue funcionando, solo no se registran
# leads. Consíguela en PostHog → Project Settings → API Keys → "Project API
# Key" (empieza por phc_…). Plan gratuito: 1M eventos/mes.
POSTHOG_KEY=

# Host de ingesta. Default: https://us.i.posthog.com (nube US).
# Si creaste el proyecto en la región EU, usa: https://eu.i.posthog.com
# POSTHOG_HOST=

# ── Telemetría de cliente (funnel visita → envío) ────────────────────────────
# OPCIONAL. Misma Project API Key que POSTHOG_KEY pero con prefijo NEXT_PUBLIC_
# (es pública por diseño: viaja en el bundle del cliente). Sin ella, el sitio
# funciona igual pero no se registran pageviews ni el funnel.
NEXT_PUBLIC_POSTHOG_KEY=

# Host de ingesta para el cliente. Default: https://us.i.posthog.com (nube US).
# Si creaste el proyecto en la región EU, usa: https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=
